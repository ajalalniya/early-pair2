# REST base. Relative works in dev (Vite proxies /api/v1 to EARLYPAIR_BACKEND).
VITE_API_BASE=/api/v1

# Stream URL. Leave empty to derive ws(s)://<current host>/api/v1/stream.
VITE_WS_URL=

# WalletConnect / Reown project id. Without it the WalletConnect connector is hidden.
VITE_WALLETCONNECT_ID=

# Dev only: where the Vite proxy forwards /api/v1 (not exposed to the browser).
EARLYPAIR_BACKEND=http://localhost:8080
