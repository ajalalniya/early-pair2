# Copy to .env in the deploy directory on the server (DEPLOY.md says where)
# and fill in. Never commit the real file.

# --- Required ---------------------------------------------------------------

# Database password. It is also placed inside a connection URL, so keep it to
# letters and digits:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs wallet sessions. The API refuses to start without it:  openssl rand -hex 32
EARLYPAIR_JWT_SECRET=

# The host people open the site on (no scheme, no path). It is written into
# the wallet sign-in message, and wallets warn when it does not match the page.
EARLYPAIR_AUTH_DOMAIN=example.com

# The full origin the site is served from.
EARLYPAIR_CORS_ORIGINS=https://example.com

# --- Optional ---------------------------------------------------------------

# Host port the site listens on. Put a TLS-terminating proxy (Caddy, nginx,
# Cloudflare) in front of it for https, which wallets expect.
WEB_PORT=80

# Override an RPC endpoint's URL without rebuilding: EARLYPAIR_RPC_URL_<ID>,
# the endpoint id from config/earlypair.yaml upper-snaked. For example:
# EARLYPAIR_RPC_URL_ARC_HTTP_BLOCKDAEMON=https://...
# EARLYPAIR_RPC_URL_RBN_HTTP_OFFICIAL=https://...

# Block explorer API keys, for source verification:
# EARLYPAIR_EXPLORER_KEY_BASE=

# How long pools are kept after their creation (default 48h; 0 keeps all).
# Starred and traded pools are always kept.
# EARLYPAIR_POOL_RETENTION=48h

# Log verbosity: debug, info, warn, error.
# EARLYPAIR_LOG_LEVEL=info
